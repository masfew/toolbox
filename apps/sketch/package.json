{
  "name": "sketch",
  "private": true,
  "version": "1.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-info.mjs --nsis",
    "test": "vitest run",
    "tauri": "tauri",
    "check:startup": "node scripts/startup-check.mjs",
    "check:size": "node scripts/size-check.mjs",
    "check:native": "node scripts/native-check.mjs",
    "check:speed": "node scripts/speed-check.mjs",
    "check:fuzz": "node scripts/fuzz-check.mjs",
    "check:update": "node scripts/update-check.mjs && node scripts/update-remote-check.mjs",
    "check:uninstall": "node scripts/uninstall-check.mjs",
    "perf": "node scripts/perf.mjs",
    "dev:hooks": "node scripts/dev-update.mjs --hooks",
    "dev:update": "node scripts/dev-update.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "fflate": "^0.8.3",
    "lucide-preact": "^1.61.0",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
