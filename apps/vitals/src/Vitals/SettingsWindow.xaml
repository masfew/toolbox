<Window x:Class="Vitals.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vitals settings" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#202020" Foreground="#F4F4F5"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="Dim" Color="#A3FFFFFF"/>

    <Style x:Key="Group" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>
    <Style x:Key="Row" TargetType="Border">
      <Setter Property="Background" Value="#0BFFFFFF"/>
      <Setter Property="BorderBrush" Value="#08FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Windows 11 style on/off switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <TextBlock x:Name="Label" Text="Off" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="#8CFFFFFF" Background="Transparent">
                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#CCFFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Border>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Label" Property="Text" Value="On"/>
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Knob" Property="Fill" Value="Black"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- segmented choice -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="4" Padding="11,5" Background="Transparent">
              <TextBlock x:Name="T" Text="{TemplateBinding Content}" FontSize="12" Foreground="{StaticResource Dim}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="#1AFFFFFF"/>
                <Setter TargetName="T" Property="Foreground" Value="#F4F4F5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- slider -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Width="18" Height="18">
              <Ellipse Fill="#454545" Stroke="#30FFFFFF" StrokeThickness="1"/>
              <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FlatSlider" TargetType="Slider">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="20">
              <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{StaticResource Accent}"/></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#F4F4F5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="5" Padding="12,6" Background="#0FFFFFFF" BorderBrush="#17FFFFFF" BorderThickness="1">
              <ContentPresenter TextElement.FontSize="12"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#1AFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <StackPanel Margin="16,4,16,16">
    <TextBlock Text="Startup" Style="{StaticResource Group}" Margin="0,6,0,6"/>
    <Border Style="{StaticResource Row}">
      <DockPanel>
        <CheckBox x:Name="StartWithWindows" DockPanel.Dock="Right" Style="{StaticResource Switch}"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Start with Windows"/>
          <TextBlock x:Name="StartHint" Text="Run Vitals when you sign in." Style="{StaticResource Hint}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border x:Name="StartViewRow" Style="{StaticResource Row}" Margin="22,0,0,3" MinHeight="46">
      <DockPanel>
        <Border DockPanel.Dock="Right" CornerRadius="6" Padding="2" Background="#40000000" BorderBrush="#12FFFFFF" BorderThickness="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="StartCollapsed" Content="Collapsed" GroupName="StartView" Style="{StaticResource Segment}"/>
            <RadioButton x:Name="StartExpanded" Content="Expanded" GroupName="StartView" Style="{StaticResource Segment}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="At sign-in, show" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <TextBlock Text="Widget" Style="{StaticResource Group}"/>
    <Border Style="{StaticResource Row}">
      <DockPanel>
        <CheckBox x:Name="AlwaysOnTop" DockPanel.Dock="Right" Style="{StaticResource Switch}"/>
        <TextBlock Text="Always on top" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <Border Style="{StaticResource Row}">
      <DockPanel>
        <CheckBox x:Name="LockPosition" DockPanel.Dock="Right" Style="{StaticResource Switch}"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Lock position"/>
          <TextBlock Text="Turn off to drag the widget somewhere else." Style="{StaticResource Hint}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Style="{StaticResource Row}">
      <DockPanel>
        <CheckBox x:Name="SnapToCorners" DockPanel.Dock="Right" Style="{StaticResource Switch}"/>
        <TextBlock Text="Snap to screen corners" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <Border Style="{StaticResource Row}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Slider x:Name="OpacitySlider" Width="120" Minimum="40" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource FlatSlider}"/>
          <TextBlock x:Name="OpacityValue" Width="38" TextAlignment="Right" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="Background opacity" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <DockPanel Margin="0,14,0,0">
      <Button x:Name="OpenConfig" DockPanel.Dock="Right" Content="Open config file" Style="{StaticResource FlatButton}"/>
      <TextBlock Text="Everything else is in the config file." FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
    </DockPanel>
  </StackPanel>
</Window>
