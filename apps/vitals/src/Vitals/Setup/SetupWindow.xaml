<Window x:Class="Vitals.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vitals Setup" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="White" Foreground="#1B1B1F"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#0067C0"/>
    <SolidColorBrush x:Key="Ink2" Color="#5B5D63"/>
    <SolidColorBrush x:Key="Line" Color="#E1E1E1"/>
    <SolidColorBrush x:Key="Chrome" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Banner" Color="#1E1E21"/>
    <SolidColorBrush x:Key="NoteBg" Color="#FFF4CE"/>
    <SolidColorBrush x:Key="NoteLine" Color="#F2D77A"/>
    <SolidColorBrush x:Key="ErrorBg" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="ErrorLine" Color="#F1A7AE"/>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Para" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="19"/>
    </Style>
    <Style x:Key="Help" TargetType="TextBlock" BasedOn="{StaticResource Para}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="LineHeight" Value="17"/>
      <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
    </Style>

    <!-- Windows 11 checkbox: a 18 px rounded square, filled with the accent and a tick when checked -->
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="#8A8A8A"
                      Background="White" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
                <Path x:Name="Tick" Data="M 3.5,9 L 7.5,13 L 14.5,5" Stroke="White" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <Border x:Name="Focus" Grid.ColumnSpan="2" Margin="-4,-3" CornerRadius="4" BorderThickness="2" BorderBrush="#1B1B1F" Visibility="Collapsed"/>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Top"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#C4C4C4"/>
                <Setter TargetName="Box" Property="Background" Value="#F3F3F3"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Collapsed"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="MinWidth" Value="84"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#1B1B1F"/>
      <Setter Property="Background" Value="#FDFDFD"/>
      <Setter Property="BorderBrush" Value="#D0D0D0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="4" BorderThickness="1" Padding="14,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#1B1B1F"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#A0A0A0"/>
                <Setter TargetName="B" Property="Background" Value="#F5F5F5"/>
                <Setter TargetName="B" Property="BorderBrush" Value="#E0E0E0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>

    <Style x:Key="Tip" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Note" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource NoteBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource NoteLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>
  </Window.Resources>

  <Grid Width="500" Height="388">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>

    <!-- 1. Welcome -->
    <Grid x:Name="WelcomePage">
      <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Banner}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <Image x:Name="WelcomeIcon" Width="72" Height="72"/>
          <TextBlock x:Name="WelcomeVersion" Foreground="#9A9CA3" FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="1" Margin="24,22,24,0">
        <TextBlock Style="{StaticResource H1}" Text="Welcome to Vitals Setup"/>
        <TextBlock Style="{StaticResource Para}" Margin="0,12,0,0" Text="Vitals is a small always-on-top widget that shows your CPU, GPU, RAM and VRAM use, with temperatures, a minute of history and the busiest apps."/>
        <TextBlock x:Name="WelcomeAdmin" Style="{StaticResource Para}" Foreground="{StaticResource Ink2}" Margin="0,10,0,0" Text="Setup installs Vitals for your Windows account only. It needs no administrator rights, unless you choose to start Vitals when you sign in."/>
        <TextBlock Style="{StaticResource Para}" Foreground="{StaticResource Ink2}" Margin="0,10,0,0" Text="Click Next to continue."/>
      </StackPanel>
    </Grid>

    <!-- 2. Options -->
    <Grid x:Name="OptionsPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14,20,12">
        <DockPanel>
          <Image x:Name="OptionsIcon" DockPanel.Dock="Right" Width="40" Height="40"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Choose how Vitals runs" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="You can change these later in Vitals' Settings." FontSize="12" Foreground="{StaticResource Ink2}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <StackPanel Grid.Row="1" Margin="20,14,20,0">
        <CheckBox x:Name="StartWithWindows" Style="{StaticResource Check}" IsChecked="True">
          <StackPanel>
            <TextBlock Text="Start Vitals when I sign in to Windows" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0" Text="Vitals starts as administrator, so it can read the CPU temperature. Windows asks for your permission once, while Vitals installs."/>
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="ClaudeLevels" Style="{StaticResource Check}" IsChecked="True" IsEnabled="False" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock x:Name="ClaudeLabel" Text="Let Claude Code pick my temperature warning levels" FontWeight="SemiBold"/>
            <TextBlock x:Name="ClaudeHelp" Style="{StaticResource Help}" Margin="0,2,0,0" Text="Checking for Claude Code..."/>
          </StackPanel>
        </CheckBox>
        <TextBlock x:Name="InstallPath" Style="{StaticResource Help}" Margin="0,16,0,0"/>
      </StackPanel>
    </Grid>

    <!-- 3. Installing -->
    <Grid x:Name="InstallingPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14,20,12">
        <DockPanel>
          <Image x:Name="InstallingIcon" DockPanel.Dock="Right" Width="40" Height="40"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="InstallingTitle" Text="Installing Vitals" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock x:Name="InstallingSub" Text="This takes a few seconds." FontSize="12" Foreground="{StaticResource Ink2}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <StackPanel Grid.Row="1" Margin="20,16,20,0">
        <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="5" Foreground="{StaticResource Accent}" Background="#E6E6E6" BorderThickness="0"/>
        <StackPanel x:Name="Steps" Margin="0,12,0,0"/>
        <Border x:Name="AdminNote" Style="{StaticResource Note}" Margin="0,12,0,0" Visibility="Collapsed">
          <TextBlock Style="{StaticResource Help}" Foreground="#1B1B1F">
            <Run FontWeight="SemiBold" Text="Windows is asking for permission."/>
            <Run Text="Click Yes in the window Windows just opened, so Vitals can start when you sign in. Click No to skip it; Vitals still installs."/>
          </TextBlock>
        </Border>
        <Border x:Name="ErrorNote" Style="{StaticResource Note}" Background="{StaticResource ErrorBg}" BorderBrush="{StaticResource ErrorLine}" Margin="0,12,0,0" Visibility="Collapsed">
          <TextBlock x:Name="ErrorText" Style="{StaticResource Help}" Foreground="#1B1B1F"/>
        </Border>
      </StackPanel>
    </Grid>

    <!-- 4. Finish -->
    <Grid x:Name="FinishPage" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Banner}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <Image x:Name="FinishIcon" Width="72" Height="72"/>
          <TextBlock x:Name="FinishVersion" Foreground="#9A9CA3" FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="1" Margin="22,18,22,0">
        <TextBlock x:Name="FinishTitle" Style="{StaticResource H1}" Text="Vitals is installed"/>
        <CheckBox x:Name="StartNow" Style="{StaticResource Check}" IsChecked="True" Margin="0,10,0,0">
          <TextBlock Text="Start Vitals now" FontWeight="SemiBold"/>
        </CheckBox>
        <Border x:Name="FinishNote" Style="{StaticResource Note}" Margin="0,10,0,0" Visibility="Collapsed">
          <TextBlock x:Name="FinishNoteText" Style="{StaticResource Help}" Foreground="#1B1B1F"/>
        </Border>
        <Border Style="{StaticResource Tip}" Margin="0,10,0,6">
          <StackPanel>
            <TextBlock Text="Keep its icon on the taskbar" FontWeight="SemiBold" FontSize="12.5"/>
            <TextBlock Style="{StaticResource Help}" Text="Windows 11 hides new tray icons in the ^ menu."/>
            <TextBlock FontSize="12" Margin="0,2,0,0"><Hyperlink x:Name="TaskbarLink" Foreground="{StaticResource Accent}" TextDecorations="{x:Null}" FontWeight="SemiBold">Open taskbar settings</Hyperlink></TextBlock>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Tip}">
          <StackPanel>
            <TextBlock FontSize="12.5"><Run Text="Show the CPU temperature" FontWeight="SemiBold"/><Run Text=" (optional)" Foreground="{StaticResource Ink2}"/></TextBlock>
            <TextBlock Style="{StaticResource Help}" Text="Needs the free PawnIO driver. Restart Vitals after installing it."/>
            <TextBlock FontSize="12" Margin="0,2,0,0"><Hyperlink x:Name="PawnIoLink" Foreground="{StaticResource Accent}" TextDecorations="{x:Null}" FontWeight="SemiBold">Get PawnIO</Hyperlink></TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Button bar -->
    <Border Grid.Row="1" Background="{StaticResource Chrome}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
        <Button x:Name="BackButton" Style="{StaticResource Btn}" Content="&lt; Back" IsEnabled="False"/>
        <Button x:Name="NextButton" Style="{StaticResource Primary}" Content="Next &gt;" IsDefault="True"/>
        <Button x:Name="CancelButton" Style="{StaticResource Btn}" Content="Cancel" IsCancel="True"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
